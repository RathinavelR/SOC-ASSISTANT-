# Backend Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/soc-assistant

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Frontend URL (CORS)
CLIENT_URL=http://localhost:5173

# Wazuh Configuration
WAZUH_MODE=self-hosted
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USERNAME=wazuh-wui
WAZUH_API_PASSWORD=
WAZUH_VERIFY_SSL=false

# Wazuh Integration Secret (for webhook)
WAZUH_INTEGRATION_SECRET=your-wazuh-integration-secret

# Wazuh Polling
WAZUH_POLL_INTERVAL=30000

# Threat Intelligence
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=

# AI Service
AI_SERVICE_URL=http://localhost:8000

# OpenAI (Optional)
OPENAI_API_KEY=

# Demo Mode
DEMO_MODE=false

# Logging
LOG_LEVEL=debug
